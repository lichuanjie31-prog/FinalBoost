APP_ENV=development
GRADING_MODE=mock
MOCK_SCENARIO=success
JOB_SECONDS=3
JOB_TIMEOUT=120
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Comma-separated, case-insensitive normalized usernames.
ADMIN_USERNAMES=admin
# DATA_DIR defaults to backend/data

# LLM Configuration (set GRADING_MODE=llm to enable)
# LLM_API_KEY=your-deepseek-api-key-here
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TIMEOUT=60
