APP_ENV=development
GRADING_MODE=mock
MOCK_SCENARIO=success
JOB_SECONDS=3
JOB_TIMEOUT=120
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# DATA_DIR defaults to backend/data

# Chat model configuration (independent from grading mode)
# LLM_API_KEY=your-deepseek-api-key-here
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TIMEOUT=60

# Real image grading requires GRADING_MODE=llm and an image-capable model.
# GRADING_API_KEY=your-vision-provider-key
# GRADING_MODEL=your-image-capable-model
# GRADING_BASE_URL=https://your-provider.example/v1

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=finalboost
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password

# RAG Configuration (Qdrant + Alibaba Embedding)
RAG_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=finalboost_chunks
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your-alibaba-api-key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Exam marking (docs/qwen-marking.md)
#   MARKING_MODE      disabled | fixture | live
#                     (a bare qwen/tencent is the legacy spelling and means "live, that provider")
#   MARKING_PROVIDER  qwen | tencent   (default: qwen)
MARKING_MODE=disabled
MARKING_PROVIDER=qwen

# --- Qwen VL marking (default provider) ---
# Reuses the DashScope credentials below when DASHSCOPE_API_KEY is unset.
# DASHSCOPE_API_KEY=your-dashscope-api-key
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MARKING_MODEL=qwen3-vl-plus
# QWEN_MARKING_TIMEOUT=120

# --- Tencent Cloud question-marking Agent (retained, switchable) ---
# TENCENTCLOUD_SECRET_ID=your-secret-id
# TENCENTCLOUD_SECRET_KEY=your-secret-key
# TENCENTCLOUD_TOKEN=            # optional temporary credential
# TENCENTCLOUD_REGION=ap-guangzhou
# TENCENTCLOUD_OCR_ENDPOINT=ocr.tencentcloudapi.com

# Vendor allowance is 10 submitted images per minute; 6s spacing matches it.
# MARKING_SUBMIT_INTERVAL=6
# MARKING_POLL_INTERVAL=6
# MARKING_REQUEST_TIMEOUT=30
